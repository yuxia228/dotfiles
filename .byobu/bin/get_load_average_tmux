#!/bin/bash

read -r load_ave _ < /proc/loadavg

core_num=0
while read -r line; do
    case $line in
        processor*) ((core_num++)) ;;
    esac
done < /proc/cpuinfo

load_int=${load_ave%.*}
load_frac=${load_ave#*.}
load_x100=$((load_int * 100 + 10#$load_frac))

if   (( load_x100 < core_num * 40 )); then
    color=blue
elif (( load_x100 < core_num * 70 )); then
    color=yellow
elif (( load_x100 < core_num * 100 )); then
    color="colour166"  # orange
else
    color=red
fi

echo "#[bg=$color]$load_ave#[default]"
