#!/bin/bash

CACHE_FILE="/tmp/.get_cpu_load_bar_cache_$UID"

read -r _ user nice sys idle _ < /proc/stat
LOAD=$((user + nice + sys))
TOTAL=$((user + nice + sys + idle))

if [ -f "$CACHE_FILE" ]; then
    read -r PREV_LOAD PREV_TOTAL < "$CACHE_FILE"
else
    PREV_LOAD=$LOAD
    PREV_TOTAL=$TOTAL
fi
echo "$LOAD $TOTAL" > "$CACHE_FILE"

DIFF_LOAD=$((LOAD - PREV_LOAD))
DIFF_TOTAL=$((TOTAL - PREV_TOTAL))

if [ "$DIFF_TOTAL" -le 0 ]; then
    CPU_LOAD=0
else
    CPU_LOAD=$((100 * DIFF_LOAD / DIFF_TOTAL))
fi
CPU_LOAD_STR="CPU:${CPU_LOAD}%"

VAL=${CPU_LOAD}

if   (( VAL < 20 )); then
    color=blue
elif (( VAL < 40 )); then
    color=green
elif (( VAL < 60 )); then
    color=yellow
elif (( VAL < 80 )); then
    color="colour166"  # orange
else
    color=red
fi

COUNT=8
BAR_NUM=$((VAL * COUNT / 100))
_BAR_NUM=$((COUNT - BAR_NUM))

BAR=""
for ((i = 0; i < BAR_NUM; i++)); do BAR+=$'█'; done
_BAR=""
for ((i = 0; i < _BAR_NUM; i++)); do _BAR+='_'; done

echo "C[#[fg=$color]${BAR}#[default]${_BAR}]"
