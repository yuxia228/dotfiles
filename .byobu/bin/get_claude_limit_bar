#!/bin/bash

COUNT=6
STATUS_FILE=~/.claude-personal/claude-status.json

# Fail check
if [[ ! -e "$STATUS_FILE" ]]; then
    exit
fi

read -r LIMIT_5H LIMIT_7D < <(jq -r '(.rate_limits.five_hour.used_percentage|floor), (.rate_limits.seven_day.used_percentage|floor)' "$STATUS_FILE" | tr '\n' ' ')

get_color () {
    VAL=$1
    case "$(( VAL / 20 ))" in
        "0") color=blue ;;
        "1") color=green ;;
        "2") color=yellow ;;
        "3") color=colour166 ;;
        *  ) color=red ;;
    esac
    echo $color
}

get_bar () {
    VAL=$1
    COUNT=${2:-$COUNT}

    BAR_NUM=$((VAL * COUNT / 100))
    _BAR_NUM=$((COUNT - BAR_NUM))

    BAR=""
    for ((i = 0; i < BAR_NUM; i++)); do BAR+=$'█'; done
    _BAR=""
    for ((i = 0; i < _BAR_NUM; i++)); do _BAR+='_'; done

    echo "${BAR}${_BAR}"
}

color_5h=$(get_color $LIMIT_5H)
color_7d=$(get_color $LIMIT_7D)

bar_5h=$(get_bar $LIMIT_5H)
bar_7d=$(get_bar $LIMIT_7D)

STATUS_5H="5H:#[fg=$color_5h]${LIMIT_5H}%[${bar_5h}]#[default]"
STATUS_7D="7D:#[fg=$color_7d]${LIMIT_7D}%[${bar_7d}]#[default]"

echo "${STATUS_5H} ${STATUS_7D}"
