#!/bin/bash

while read -r key value _; do
    case "$key" in
        MemTotal:) MEM_TOTAL=$value ;;
        MemAvailable:) MEM_AVAIL=$value ;;
    esac
done < /proc/meminfo

VAL=$(((MEM_TOTAL - MEM_AVAIL) * 100 / MEM_TOTAL))
LOAD_STR="RAM:${VAL}%"

if   (( VAL < 20 )); then
    color=blue
elif (( VAL < 40 )); then
    color=green
elif (( VAL < 60 )); then
    color=yellow
elif (( VAL < 80 )); then
    color="colour166"  # orange
else
    color=red
fi

COUNT=8
BAR_NUM=$((VAL * COUNT / 100))
_BAR_NUM=$((COUNT - BAR_NUM))

BAR=""
for ((i = 0; i < BAR_NUM; i++)); do BAR+=$'█'; done
_BAR=""
for ((i = 0; i < _BAR_NUM; i++)); do _BAR+='_'; done

echo "M[#[fg=$color]${BAR}#[default]${_BAR}]"
