{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "plugin": [
    "@bybrawe/opencode-loop@0.5.36"
  ],
  "model": "main/main",
  "small_model": "sub/sub",
  "provider": {
    "main": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "main": {
          "name": "main",
          "modalities": {
              "input": ["text", "image"],
              "output": ["text"]
          },
          "limit": {
            "context": 130000,
            "output": 32768
          }
        }
      }
    },
    "sub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://localhost:8081/v1"
      },
      "models": {
        "sub": {
          "name": "sub",
          "limit": {
            "context": 80000,
            "output": 32768
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "explorer": "allow"
        }
      }
    },
    "explorer": {
      "description": "コードベースを高速に調査する軽量サブエージェント。関連ファイル、関数、クラス、参照箇所、設定、TODOなどを探索する用途に使用する。コードの設計や複雑な問題解決、ファイル編集には使用しない。",
      "mode": "subagent",
      "model": "sub/sub",
      "permission": {
        "edit": "deny"
      }
    }
  }
}
