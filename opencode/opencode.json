{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@bybrawe/opencode-loop"],
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "local": {
          "name": "localhost",
          "limit": {
            "context": 40960,
            "output": 4096
          }
        }
      }
    },
    "server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://192.168.20.200:8080/v1"
      },
      "models": {
        "main": {
          "name": "main",
          "limit": {
            "context": 40960,
            "output": 4096
          }
        }
      }
    },
    "server-sub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://192.168.20.200:8081/v1"
      },
      "models": {
        "sub": {
          "name": "sub",
          "limit": {
            "context": 40960,
            "output": 4096
          }
        }
      }
    }
  }
}
